# Server-side Groq API credential used by AI form generation.
GROQ_API_KEY=replace-with-your-groq-api-key

# Add this variable to the app's existing environment configuration.
# Use the same random value in every environment that serves form links.
# Generate with: openssl rand -base64 48
FORM_LINK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
